# One creator's live app. Copy this folder to creators/<id>/, fill every value in, then
#   ./alive up <id>
# Each value names something a recipe already built (alive/recipes/README.md lists them).
DISPLAY="<how the page names them>"
VOICE_PROFILE=<voice recipe profile with a released bundle>     # engines/text2audio/blocks/voice
FACE_PROFILE=<mesh-to-render profile>                           # engines/audio2face/gauss/recipes/mesh-to-render
FACE_RUN=<that profile's RUN_DEPLOY>
FACE_BODY=random                # real body. "random:<recording>" if filmed in several sets
STYLE_CREATOR=<answer engine creator id>                        # engines/knowledge_style
WPS=<words per second: words / seconds over the voice dataset's manifest>
SAMPLES="<three or four questions this creator's archive can answer, separated by |>"
REST=""                         # <clip>@<frame>, picked by looking: recipes/README.md, "Resting pose"
REST_HOLD=0                     # 1 = hold that one frame still (when no calm stretch qualifies)
