# One creator for the live app: ./alive up drk
DISPLAY="Dr K"
VOICE_PROFILE=drk
FACE_PROFILE=drk                # mesh-to-render profile
FACE_RUN=G4_teeth               # its released renderer, checkpoints/drk/face/render/
# Real body, kept to ONE recording: he was filmed in three sets, and the resting loop and
# the answers must come from the same one. This is the fireplace set (30 fps, no overlay);
# "is it too late" has a live chat burned in, "biology" is 23.976 fps.
FACE_BODY="random:the_harsh_reality_of_women_s_attraction_SY0BNyFeQ9Q"
STYLE_CREATOR=healthygamer      # alive knowledge_style creator id (its promoted config)
WPS=3.4                         # speaking rate; the demo speaks about 75 s of an answer
SAMPLES="Is using ChatGPT as a therapist actually bad for me?|Why do I have almost no close friends as a guy in my late twenties?|Should I just force myself to be more disciplined?|Who are you?"
# Resting pose, chosen by looking (recipes/README.md, "Resting pose"), 2026-10-03.
# No 4 s stretch of this set is both frontal and hands-down: 26 candidates looked at,
# every one gestures. So HOLD one frame that is: c013 frame 522, frontal 0.84, hands down.
# (Moving from 522 he turns away, frontal 0.3-0.4, and the head render smears.)
REST="the_harsh_reality_of_women_s_attraction_SY0BNyFeQ9Q__c013@522"
REST_HOLD=1
