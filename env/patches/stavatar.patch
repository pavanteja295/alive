+    g = MeshGaussianModel(3, ASSETS, uv_size=512, pose_mode=mode, source_path=DATA)
+    g.load_meshes(src, {}, {}, {})
+    g.select_mesh_by_timestep(0)
+    g.create_from_pcd(None, 1.0)
+    return g
+
+
+def main():
+    src = {i: dict(np.load(f'{DATA}/meshes/{t:05d}.npz')) for i, t in enumerate(FRAMES)}
+    gp, gc = build('posed', src), build('canonical', src)
+    r = np.load(f'{DATA}/rigid_nerf.npz')
+
+    w = dict(center=0.0, scaling=0.0, orien_p99=0.0, xyz=0.0)
