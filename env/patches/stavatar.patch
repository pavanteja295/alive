@@ -0,0 +1,21 @@
+# CUDA extensions compiled from source against the already-installed torch.
+#
+# Install with:
+#   conda activate stavatar
+#   TORCH_CUDA_ARCH_LIST="12.0" pip install --no-build-isolation -r requirements-build.txt
+#
+# --no-build-isolation is mandatory: every setup.py here imports torch, which a
+# PEP 517 isolated build environment would not have.
+#
+# The environment must be *activated*, not merely on PATH: pytorch3d's setup.py
+# locates CUB via $CONDA_PREFIX/include. If CONDA_PREFIX still points at a base
+# conda that has an older CUDA installed, the build silently picks up that
+# CUDA's crt/host_config.h and dies on "unsupported GNU version".
+#
+# TORCH_CUDA_ARCH_LIST="12.0" targets sm_120. torch would auto-detect the local
+# GPU if it is unset, but setting it makes the wheels reproducible off-machine.
+
+pytorch3d @ git+https://github.com/facebookresearch/pytorch3d.git
+submodules/diff-gaussian-rasterization
+submodules/simple-knn
+submodules/fused-ssim
