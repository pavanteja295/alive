+# STAvatar environment, adapted for NVIDIA Blackwell (RTX 50-series, compute capability sm_120).
+#
+# The upstream pins (CUDA 11.7 / PyTorch 2.0.1) cannot run on Blackwell at all:
+# no CUDA toolkit before 12.8 emits sm_120 code, and torch 2.0.1+cu117 has no
+# sm_120 in its arch list. Every deviation below exists for that reason or falls
+# out of it. See README.md ("Blackwell / RTX 50-series") for the full rationale.
+#
+#   conda env create -f environment.yml
+#   conda activate stavatar
+#   conda env config vars set CUDA_HOME=$CONDA_PREFIX && conda activate stavatar
+#   TORCH_CUDA_ARCH_LIST="12.0" pip install --no-build-isolation -r requirements-build.txt
+#
+name: stavatar
+channels:
+  - conda-forge
+dependencies:
+  # Python 3.10, not 3.11+: stock chumpy==0.70 is needed to unpickle
+  # flame_model/assets/flame/flame2023.pkl, and it calls inspect.getargspec,
+  # which was removed in Python 3.11.
+  - python=3.10
+
+  - git
+  - ffmpeg
+  - ninja
+
+  # CUDA 12.8 is the first toolkit that can target sm_120.
+  # cuda-nvcc_linux-64 also pulls in gcc 14, which nvcc 12.8 accepts;
+  # a distro gcc 15 (Ubuntu 25.10) is rejected by nvcc's host_config.h.
+  - cuda-nvcc=12.8
+  - cuda-toolkit=12.8
+
+  - pip
+  - pip:
+      - -r requirements.txt
