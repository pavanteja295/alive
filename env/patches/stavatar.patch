     scene = Scene(dataset, gaussians)
+
+    # PER-RECORDING APPEARANCE.
+    # The per-frame network writes colour and opacity (channels 10:14) and is conditioned
+    # on the control values alone, so it has no legitimate way to know which recording a
+    # frame came from -- and it infers it from the expression, which is right on clips from
+    # a recording it trained on and wrong everywhere else. Given an explicit constant per
+    # recording it cannot drift inside a clip, and at inference one is chosen rather than
+    # predicted. Groups are read off the chunk directory names, so this needs no profile.
+    gaussians.timestep_group = None
+    if getattr(opt, "per_take_appearance", False):
+        import json as _json, os as _os
+        _g, _t2g = {}, {}
+        for _jf in ("transforms_train.json", "transforms_val.json", "transforms_test.json"):
+            _pth = _os.path.join(dataset.source_path, _jf)
+            if not _os.path.exists(_pth):
+                continue
+            for _fr in _json.load(open(_pth))["frames"]:
+                _chunk = _fr["file_path"].split("/images/")[0].split("/")[-1]
+                _name = _chunk.split("__c")[0].replace("predicted__", "")
+                _t2g.setdefault(int(_fr["timestep_index"]), _g.setdefault(_name, len(_g)))
+        if not _g:
+            raise SystemExit("per_take_appearance: no frames found to group. "
+                             "Chunk names are expected to look like <recording>__cNNN.")
+        _T = gaussians.num_timesteps
+        _map = torch.zeros(_T, dtype=torch.long)
+        for _k, _v in _t2g.items():
+            if _k < _T:
+                _map[_k] = _v
+        # KEPT ON THE CPU DELIBERATELY. It is indexed once per iteration and the result
+        # is converted to a Python int; doing that on a CUDA tensor forces a device
+        # synchronisation every step, which measured ~2.8x slower end to end.
+        gaussians.timestep_group = _map
+        gaussians.appearance_group_names = sorted(_g, key=_g.get)
+        print(f"[appearance] {len(_g)} groups: " +
+              ", ".join(f"{k}({sum(1 for v in _t2g.values() if v == _g[k])})" for k in _g))
+        gaussians.setup_appearance(len(_g))
+
     gaussians.training_setup(opt)
     camera_dataset = scene.getTrainCameras()
     train_data_len = len(camera_dataset)
@@ -74,9 +119,20 @@ def training(
