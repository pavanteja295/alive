+++ b/scripts/export_world_ply.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python
+"""Bake a mesh-bound STAvatar checkpoint into a standard 3DGS .ply.
+
+STAvatar's saved point_cloud.ply stores each Gaussian in its *bound triangle's*
+local frame plus a `binding` index, so a generic splat viewer (SuperSplat,
+GaussianSplats3D) renders nonsense. This resolves the binding at one timestep
+and writes world-space values in the layout vanilla 3DGS viewers expect.
+
+    cd .../STAvatar && conda activate stavatar
+    python scripts/export_world_ply.py -m <model_dir> -s <source_dir> -r 2 --timestep 0
+
+Attribute layout written (vanilla 3DGS):
+    x y z  nx ny nz  f_dc_0..2  f_rest_0..N  opacity  scale_0..2  rot_0..3
+Values are stored pre-activation, matching the convention viewers assume:
+    scale -> log(world_scale),  opacity -> logit(alpha),  rot -> unit quat (wxyz)
+"""
+import os
+import sys
+from argparse import ArgumentParser
+
+import numpy as np
+import torch
+from plyfile import PlyData, PlyElement
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from arguments import ModelParams, PipelineParams, get_combined_args  # noqa: E402
+from gaussian_renderer import FlameGaussianModel  # noqa: E402
+from scene import Scene  # noqa: E402
+
+
+def main():
+    parser = ArgumentParser("Bake bound Gaussians to a world-space ply")
+    model = ModelParams(parser, sentinel=True)
+    PipelineParams(parser)
+    parser.add_argument("--iteration", default=-1, type=int)
+    parser.add_argument("--timestep", default=0, type=int,
+                        help="which frame's pose to bake the Gaussians into")
+    parser.add_argument("--out", default=None)
+    parser.add_argument("--quiet", action="store_true")
+    args = get_combined_args(parser)
+    dataset = model.extract(args)
+
+    gaussians = FlameGaussianModel(dataset.sh_degree, dataset.disable_flame_static_offset)
+    scene = Scene(dataset, gaussians, load_iteration=args.iteration, shuffle=False)
+    gaussians.select_mesh_by_timestep(args.timestep)
+
+    with torch.no_grad():
+        xyz = gaussians.get_xyz.detach().cpu().numpy()
+        scale = gaussians.get_scaling.detach().cpu().numpy()      # activated (world)
+        rot = gaussians.get_rotation.detach().cpu().numpy()        # unit quat, wxyz
+        opa = gaussians.get_opacity.detach().cpu().numpy()         # sigmoid-activated
+        f_dc = gaussians._features_dc.detach().transpose(1, 2).flatten(start_dim=1).cpu().numpy()
+        f_rest = gaussians._features_rest.detach().transpose(1, 2).flatten(start_dim=1).cpu().numpy()
+
+    # invert the activations viewers will re-apply
+    scale_raw = np.log(np.clip(scale, 1e-12, None))
+    opa_raw = np.log(np.clip(opa, 1e-6, 1 - 1e-6) / (1 - np.clip(opa, 1e-6, 1 - 1e-6)))
+
+    names = ["x", "y", "z", "nx", "ny", "nz"]
+    names += [f"f_dc_{i}" for i in range(f_dc.shape[1])]
+    names += [f"f_rest_{i}" for i in range(f_rest.shape[1])]
+    names += ["opacity"] + [f"scale_{i}" for i in range(3)] + [f"rot_{i}" for i in range(4)]
+
+    attrs = np.concatenate(
+        [xyz, np.zeros_like(xyz), f_dc, f_rest, opa_raw, scale_raw, rot], axis=1
+    ).astype(np.float32)
+
+    el = np.empty(attrs.shape[0], dtype=[(n, "f4") for n in names])
+    el[:] = list(map(tuple, attrs))
+
+    # get_combined_args drops cmdline args left at None, so read defensively
+    out = getattr(args, "out", None) or os.path.join(
+        dataset.model_path, f"world_t{args.timestep:05d}_{scene.loaded_iter}.ply")
+    PlyData([PlyElement.describe(el, "vertex")]).write(out)
+
+    print(f"gaussians    : {len(xyz)}")
+    print(f"timestep     : {args.timestep}   iteration: {scene.loaded_iter}")
+    print(f"bbox (m)     : min {xyz.min(0).round(4)}  max {xyz.max(0).round(4)}")
+    print(f"scale (m)    : median {np.median(scale):.5f}  max {scale.max():.5f}")
+    print(f"opacity      : median {np.median(opa):.3f}")
+    print(f"wrote        : {out}  ({os.path.getsize(out)/1e6:.1f} MB)")
+
+
+if __name__ == "__main__":
+    main()
