+    print("\nthe margin is load-bearing:")
+    for bad in (0, 1):
+        with torch.no_grad():
+            d = (blk(gf, dm, ex, masks['lips'])
+                 - blk(gf, dm, ex, masks['lips'], mask_box(masks['lips'], bad))).abs().max().item()
+        ok = d > 0.0
+        fails += [] if ok else [f"margin {bad} was exact; the receptive-field argument is wrong"]
+        print(f"  margin {bad}: differs by {d:.3e}   {'as expected' if ok else 'UNEXPECTEDLY EXACT'}")
+
+    soft = torch.zeros(1, S, S, device=DEV)
+    soft[0, 100:110, 100:110] = 1.0
+    soft[0, 40:160, 40:160] = torch.clamp(soft[0, 40:160, 40:160], min=0.01)
+    got = mask_box(soft, m)
+    ok = got == (38, 162, 38, 162)
+    fails += [] if ok else [f"soft-mask box {got}, expected (38, 162, 38, 162)"]
+    print(f"\na feathered mask's box follows its 0.01 tail: {got}   {'ok' if ok else 'WRONG'}")
+
+    try:
+        mask_box(torch.zeros(1, S, S, device=DEV), m)
