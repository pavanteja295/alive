+# Wheel-installable dependencies (no compilation).
+# The CUDA extensions that must be built from source live in requirements-build.txt.
+
+--extra-index-url https://download.pytorch.org/whl/cu128
+--find-links https://data.pyg.org/whl/torch-2.8.0+cu128.html
+
+# PyTorch 2.8.0 / CUDA 12.8 - carries sm_120 (Blackwell) in its arch list.
+# Upstream's torch==2.0.1 + cu117 cannot execute on an RTX 50-series GPU.
+# 2.8.0 specifically, because it is the newest torch with a prebuilt
+# torch-scatter wheel (see below), which saves a source build.
+torch==2.8.0+cu128
+torchvision==0.23.0+cu128
+torchaudio==2.8.0+cu128
+
+# numpy is pinned between two hard walls:
+#   >= 1.24 removes np.bool / np.float / np.object, which chumpy 0.70 imports
+#   <  1.23.5 is below scipy's floor for the versions that support Python 3.10
+# Upstream's numpy==1.22.3 sits below that floor and cannot be used here.
+numpy==1.23.5
+
+# Required to unpickle flame_model/assets/flame/flame2023.pkl, which stores
+# chumpy arrays. Not imported anywhere in this codebase, but pickle needs it.
+chumpy==0.70
+
+# Prebuilt for exactly torch 2.8.0 + cu128 + cp310; no compilation needed.
+torch-scatter==2.1.2+pt28cu128
