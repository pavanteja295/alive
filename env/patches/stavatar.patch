+        w['scaling'] = max(w['scaling'], (gp.face_scaling - gc.face_scaling).abs().max().item())
+        eo = (gp.face_orien_mat
+              - torch.einsum('ij,njk->nik', R.T, gc.face_orien_mat)).abs().amax(dim=(1, 2))
+        w['orien_p99'] = max(w['orien_p99'],
